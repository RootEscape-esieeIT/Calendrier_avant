# Copie ce fichier en « .env » et adapte les valeurs.

# Port d'écoute de Node (nginx redirige vers ce port)
PORT=3000

# Le calendrier se joue en décembre de cette année, à l'heure de ce fuseau
ANNEE=2026
FUSEAU=Europe/Paris

# 1 = les jours passés restent ouverts (on peut rattraper une énigme manquée)
# 0 = seule l'énigme du jour est ouverte (les énigmes déjà résolues restent consultables)
RATTRAPAGE=1

# 1 = toutes les portes ouvertes, pour tester. NE JAMAIS LAISSER À 1 EN PRODUCTION.
MODE_TEST=0

# 1 si nginx / Apache est devant Node (nécessaire pour le HTTPS et l'anti force brute)
DERRIERE_PROXY=1

# Base MySQL / MariaDB. Laisser MYSQL_HOTE vide = stockage en mémoire (tests uniquement)
MYSQL_HOTE=localhost
MYSQL_PORT=3306
MYSQL_UTILISATEUR=noelos
MYSQL_MOT_DE_PASSE=change-moi
MYSQL_BASE=noelos

# Signe les cookies de connexion des joueurs. Mets une longue chaîne aléatoire, par exemple le résultat de :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si tu la changes, tous les joueurs devront se reconnecter (leur progression, elle, reste).
SECRET_SESSION=

# Accès à la page des statistiques : https://ton-domaine/admin
ADMIN_UTILISATEUR=admin
ADMIN_MOT_DE_PASSE=
